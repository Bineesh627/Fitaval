# ==============================================================================
# Fitaval Frontend — Production Environment Configuration
# ==============================================================================

# Target Django REST Framework production API
VITE_API_BASE_URL=https://api.fitaval.com/api/v1

# In production, mock mode must always be false (fail-closed)
VITE_ENABLE_MOCK_API=false

# Deployment environment identifier
VITE_APP_ENV=production

# CDN or S3 media asset storage URL
VITE_IMAGE_BASE_URL=https://cdn.fitaval.com

# Production Stripe Public Key
VITE_STRIPE_PUBLIC_KEY=pk_live_your_production_stripe_key

