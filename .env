# ==============================================================================
# Fitaval Local Development Environment Configuration
# ==============================================================================

# Django REST API Base URL
# - Local Django backend: http://127.0.0.1:8000/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Toggle Mock API Mode for Development
# - true: Uses local mock data for testing and standalone UI development
# - false: Connects directly to local Django REST API at 127.0.0.1:8000
VITE_ENABLE_MOCK_API=true

# Application Environment ('development' | 'staging' | 'production')
VITE_APP_ENV=development

# Media / Uploaded image base URL
VITE_IMAGE_BASE_URL=http://127.0.0.1:8000

# Stripe Public Key (test key)
VITE_STRIPE_PUBLIC_KEY=pk_test_sample_fitaval_key

