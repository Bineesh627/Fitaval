# ==============================================================================
# Fitaval Frontend — Environment Configuration Template
# Target Backend: Django REST Framework (DRF)
# ==============================================================================

# Django REST API Base URL
# - Local Django backend: http://127.0.0.1:8000/api/v1
# - Production API: https://api.fitaval.com/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Toggle Mock API Mode
# - true: Uses local mock data for testing (only permitted when VITE_APP_ENV=development)
# - false: Connects directly to live Django REST API
VITE_ENABLE_MOCK_API=true

# Application Environment ('development' | 'staging' | 'production')
VITE_APP_ENV=development

# Media / CDN Base URL for uploaded images
VITE_IMAGE_BASE_URL=http://127.0.0.1:8000

# Stripe Public Key
VITE_STRIPE_PUBLIC_KEY=pk_test_sample_fitaval_key

